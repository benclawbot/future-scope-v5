{
  "name": "future-scope",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:live": "node test/live-provider-check.mjs",
    "check:csp": "node scripts/verify-csp.mjs",
    "check:data": "node scripts/check-production-data.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check": "npm run check:syntax && npm run check:csp && npm run check:data",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "vitest": "4.1.9",
    "wrangler": "4.102.0"
  },
  "engines": {
    "node": ">=24"
  }
}
