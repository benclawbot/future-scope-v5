{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "future-scope-proxy",
  "main": "proxy/worker.js",
  "compatibility_date": "2026-06-18",
  "workers_dev": true,
  "limits": {
    "cpu_ms": 300000
  },
  "secrets": {
    "required": [
      "BRAVE_SEARCH_API_KEY",
      "MINIMAX_API_KEY",
      "APP_AUTH_TOKEN",
      "IP_HASH_PEPPER"
    ]
  },
  "ratelimits": [
    {
      "name": "PER_IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:4173",
    "LOG_LEVEL": "info",
    "APP_VERSION": "5.0.0",
    "ALLOW_DEV_KEY_OVERRIDES": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
